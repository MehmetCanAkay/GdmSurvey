# OpenAI API Anahtarı
OPENAI_API_KEY=sk-...

# Anthropic API Anahtarı
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (Gemini) API Anahtarı
GOOGLE_API_KEY=...

# Yerli Model API (OpenAI uyumlu uç nokta, yerelde mlx_lm.server)
# mlx_lm.server anahtar istemez; herhangi bir değer yeterlidir.
LOCAL_MODEL_API_KEY=not-needed
LOCAL_MODEL_ENDPOINT=http://localhost:8080/v1

# Model sürüm dizgileri bu dosyada değil, config/models.yaml içindedir.

# Bulut veritabanı (opsiyonel - Supabase PostgreSQL)
# Bu satır yoksa otomatik olarak lokal SQLite kullanılır
# DATABASE_URL=postgresql://postgres:SIFRE@db.PROJEID.supabase.co:5432/postgres
