# Bu dosya Streamlit Community Cloud'daki "Secrets" bölümüne yapıştırılacak.
# Lokal geliştirmede .streamlit/secrets.toml olarak kopyalayın.
# ASLA bu dosyayı gerçek değerlerle GitHub'a commit etmeyin!

# Supabase PostgreSQL bağlantı URL'si (ücretsiz hesap: supabase.com)
DATABASE_URL = "postgresql://postgres:[SIFRE]@db.[PROJE_ID].supabase.co:5432/postgres?sslmode=require"

# Alternatif: SQLite kullanmak istiyorsanız bu satırı yorum yapın veya silin.
# DATABASE_URL yoksa otomatik olarak lokal SQLite kullanılır.
